{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.invalid/schemas/status.schema.json",
  "title": "ygg.status.v1",
  "type": "object",
  "required": ["schema", "generated_at", "clock_source", "paused", "programmes", "projects", "nodes",
    "decisions_open", "morning_go_queue", "inbox_pending", "held_launches", "uncertain_keys",
    "relay_grants", "ignored_authority", "work_packages"],
  "properties": {
    "schema": {"const": "ygg.status.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "clock_source": {"enum": ["system", "override"]},
    "paused": {"type": "object", "required": ["global", "programmes"],
      "properties": {"global": {"type": "boolean"}, "programmes": {"type": "array", "items": {"type": "string"}}}},
    "programmes": {"type": "array", "items": {"type": "object",
      "required": ["id", "domain", "home", "kind", "envelope"],
      "properties": {"id": {"type": "string"}, "domain": {"type": "string"}, "home": {"type": "string"},
        "kind": {"enum": ["git-repo", "shared-tree", "vault-docs", null]},
        "envelope": {"$ref": "#/$defs/envelope"}}}},
    "projects": {"type": "array", "items": {"type": "object",
      "required": ["id", "programme", "pm", "shape", "state", "stage", "health", "blockers", "route_map", "envelope"],
      "properties": {"id": {"type": "string"}, "programme": {"type": "string"}, "pm": {"type": "string"},
        "shape": {"enum": ["standard", "collapsed"]},
        "state": {"enum": ["initiating", "pid-ready", "pid-rejected", "executing", "awaiting-approval", "exception", "closed"]},
        "hold": {"type": ["string", "null"]},
        "stage": {"type": ["object", "null"], "required": ["number", "state", "approved_by"],
          "properties": {"number": {"type": "integer", "minimum": 1},
            "state": {"enum": ["planned", "executing", "awaiting-approval", "approved", "rejected"]},
            "approved_by": {"enum": ["user", "envelope", null]}}},
        "health": {"enum": ["onTrack", "atRisk", "offTrack"]},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "route_map": {"type": ["object", "null"],
          "properties": {"forecast_end": {"type": ["string", "null"], "format": "date-time"}}},
        "envelope": {"$ref": "#/$defs/envelope"},
        "delivery": {"type": "object", "required": ["approach", "source", "cadence", "business_case"],
          "properties": {"approach": {"enum": ["waterfall", "agile", "custom"]},
            "source": {"enum": ["pid", "programme", "profile", "core"]},
            "cadence": {"enum": ["flow", "timebox", null]},
            "description": {"type": ["string", "null"]},
            "timebox": {"type": ["object", "null"], "required": ["stage", "number", "planned_end"],
              "properties": {"stage": {"type": "integer"}, "number": {"type": "integer"},
                "planned_end": {"type": "string", "format": "date-time"}}},
            "wip": {"type": ["object", "null"], "required": ["limit", "in_progress"],
              "properties": {"limit": {"type": ["integer", "null"]}, "in_progress": {"type": "integer"}}},
            "backlog": {"type": ["object", "null"], "required": ["order", "open", "must_open"],
              "properties": {"order": {"type": "array", "items": {"type": "string"}},
                "open": {"type": "integer"}, "must_open": {"type": "integer"}}},
            "business_case": {"enum": ["present", "skipped"]},
            "justified_last": {"enum": ["yes", "no", "unstated", "not-applicable", null]}}}}}},
    "nodes": {"type": "array", "items": {"type": "object",
      "required": ["id", "role", "parent", "programme", "project", "pairs_with", "state", "blocked_by", "activation"],
      "properties": {"id": {"type": "string"},
        "role": {"enum": ["l1", "pm", "tl", "su", "worker", "reviewer"]},
        "parent": {"type": ["string", "null"]}, "programme": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "pairs_with": {"type": "array", "items": {"type": "string"}},
        "state": {"enum": ["idle", "queued", "running", "blocked", "held-load", "held-capacity", "stalled", "stalled-suspect", "stopped"]},
        "blocked_by": {"type": "array", "items": {"type": "string"}},
        "activation": {"type": ["object", "null"], "required": ["id", "launcher", "outcome"],
          "properties": {"id": {"type": "string"}, "launcher": {"enum": ["t3", "headless"]},
            "outcome": {"enum": ["confirmed", "uncertain"]}}}}}},
    "decisions_open": {"type": "array", "items": {"type": "string"}},
    "morning_go_queue": {"type": "array", "items": {"type": "object",
      "required": ["id", "programme", "kind", "status"],
      "properties": {"id": {"type": "string"}, "programme": {"type": "string"}, "project": {"type": ["string", "null"]},
        "kind": {"enum": ["stage-end", "provisional-decision", "lane-merge", "work-ahead"]},
        "ref": {"type": "string"},
        "status": {"enum": ["pending-user", "accepted", "rejected"]},
        "commit_ranges": {"type": "array", "items": {"type": "object", "required": ["repo", "branch", "range"],
          "properties": {"repo": {"type": "string"}, "branch": {"type": "string"}, "range": {"type": "string"}}}}}}},
    "inbox_pending": {"type": "array", "items": {"type": "object", "required": ["node", "msg_id"],
      "properties": {"node": {"type": "string"}, "msg_id": {"type": "string"}}}},
    "held_launches": {"type": "array", "items": {"type": "string"}},
    "uncertain_keys": {"type": "array", "items": {"type": "string"}},
    "relay_grants": {"type": "array", "items": {"type": "object", "required": ["from_domain", "to_domain"],
      "properties": {"from_domain": {"type": "string"}, "to_domain": {"type": "string"}}}},
    "ignored_authority": {"type": "array", "items": {"type": "object", "required": ["record", "actor", "reason"],
      "properties": {"record": {"type": "string"}, "actor": {"type": "string"}, "reason": {"type": "string"}}}},
    "work_packages": {"type": "array", "items": {"type": "object",
      "required": ["id", "project", "lane", "state", "standard_version"],
      "properties": {"id": {"type": "string"}, "project": {"type": "string"}, "lane": {"type": ["string", "null"]},
        "state": {"enum": ["planned", "authorised", "ready-for-test", "accepted", "rejected", "review-exhausted", "suspended", "merged"]},
        "standard_version": {"type": "integer", "minimum": 1}}}}
  },
  "$defs": {
    "envelope": {"type": ["object", "null"],
      "required": ["id", "scope", "until", "through_stage", "granted_at", "allow_local_merge", "ref_snapshot", "state"],
      "properties": {"id": {"type": "string"}, "scope": {"type": "string"},
        "until": {"type": ["string", "null"], "format": "date-time"},
        "through_stage": {"type": ["integer", "null"]},
        "granted_at": {"type": "string", "format": "date-time"},
        "allow_local_merge": {"type": "boolean"},
        "grants": {"type": "array", "items": {"type": "string"}},
        "ref_snapshot": {"type": "array", "items": {"type": "object", "required": ["repo", "branch", "sha"],
          "properties": {"repo": {"type": "string"}, "branch": {"type": "string"}, "sha": {"type": "string"}}}},
        "state": {"enum": ["active", "ended", "revoked"]}}}
  }
}
