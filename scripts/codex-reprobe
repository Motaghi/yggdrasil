ROWS = ("P-1", "P-3", "P-4", "P-5", "P-7", "P-8", "P-10", "P-12", "P-13", "CB-28", "CB-16", "CB-25")
LIVE = ("CB-16", "CB-25")
# Every row the script runs itself, by the Probe method that runs it.
RUNNERS = {"P-1": "p1", "P-3": "p3", "P-4": "p4", "P-5": "p5", "P-7": "p7", "P-8": "p8", "P-10": "p10",
           "P-12": "p12", "P-13": "p13", "CB-28": "cb28"}
# The names Yggdrasil's hermetic config keeps out of the agent's commands, as P-12 sets them (dummy values only).
KEY_NAMES = ("CODEX_API_KEY", "OPENAI_API_KEY", "CODEX_ACCESS_TOKEN", "REPROBE_KEY", "REPROBE_HEADER")
# A proxy address nothing listens on: every request that does not go to the local stand-in fails.
DEAD_PROXY = "http://127.0.0.1:9"
# What the link probe and the Codex runs it starts put in its login folder `<parent>/L`, removed by name at the end.
P13_LOGIN_FILES = ("auth.json", "auth.lock", "auth.json.lock", "config.toml")
ACCOUNT = "8f0b6a7e-2c1d-4e5f-9a3b-1c2d3e4f5a6b"  # a made-up account id for P-13's dummy login
DISABLED = ("hooks", "apps", "plugins", "remote_plugin", "plugin_sharing", "browser_use", "browser_use_external",
